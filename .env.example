# Readbook configuration — everything here is OPTIONAL.
#
# Readbook runs with no .env at all. `pnpm run setup` copies this file to .env
# (it never overwrites an existing one); edit that copy, never this template.
#
# Precedence: a value saved on the Settings page (in the browser) wins over this
# file, and this file never overrides a variable already set in your shell.
# Settings covers FIRECRAWL_API_KEY, READBOOK_FIRECRAWL_PROXY,
# READBOOK_ALLOW_PRIVATE_NETWORK and READBOOK_USER_AGENT; the rest are env-only.
#
# Loaded by `pnpm dev`, `pnpm build`, `pnpm start` and `pnpm preview`. In Docker,
# pass variables through compose.yaml / `docker run -e` instead.

# ── Extraction ───────────────────────────────────────────────────────────────

# Firecrawl API key (https://www.firecrawl.dev). Used ONLY as a fallback when the
# local reader (Mozilla Readability) fails or comes back thin, e.g. JS-heavy
# pages. Empty = Readability-only; sites that need Firecrawl fail with a clear
# error. Easier: paste it on the Settings page instead.
FIRECRAWL_API_KEY=

# Firecrawl proxy mode: "basic" (default) or "auto" (lets Firecrawl retry via its
# stealth proxy when a site blocks it; costs more credits).
# READBOOK_FIRECRAWL_PROXY=basic

# User-Agent for page fetches. Empty = Readbook's honest, identifiable default
# ("Mozilla/5.0 (compatible; Readbook/<version>; +<homepage>)").
# READBOOK_USER_AGENT=

# Allow fetching links on loopback / private / link-local networks (a home-lab
# wiki, an intranet). Off by default so a pasted or forged link can't make the
# server probe your LAN or a cloud metadata endpoint. 1/true/yes to enable.
# READBOOK_ALLOW_PRIVATE_NETWORK=false

# ── Storage ──────────────────────────────────────────────────────────────────

# SQLite database file. Relative paths resolve from the repo root.
# Default: ./data/readbook.db (created on first run).
# READBOOK_DB_PATH=./data/readbook.db

# ── Server ───────────────────────────────────────────────────────────────────

# There is no login: anyone who can reach the port owns your shelf.
# HOST and PORT apply to the production server (`pnpm start`, Docker).
# `pnpm dev` always uses http://localhost:4321.
# HOST=localhost
# PORT=4321

# Extra hostnames the server will answer to (comma-separated). localhost,
# 127.0.0.1 and [::1] are always allowed. Needed when you set HOST=0.0.0.0 to
# read from another device, e.g. READBOOK_ALLOWED_HOSTS=192.168.1.20,readbook.lan
# This is DNS-rebinding protection; "*" disables it (not recommended).
# READBOOK_ALLOWED_HOSTS=
