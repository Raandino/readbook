---
/**
 * SiteHeader — wordmark + the three places in the app (Shelf, Notebook,
 * Settings). Shared by every non-reader page so navigation stays identical.
 */
interface Props {
  /** Which nav item is the current page. */
  current?: "shelf" | "notebook" | "settings";
  tagline?: string;
}

const { current, tagline = "Everything you mean to read, in one calm place." } = Astro.props;

const links = [
  { key: "shelf", href: "/", label: "Shelf" },
  { key: "notebook", href: "/notebook", label: "Notebook" },
  { key: "settings", href: "/settings", label: "Settings" },
] as const;
---

<header class="site-header">
  <div>
    <p class="site-title"><a href="/">Readbook</a></p>
    <p class="site-tagline">{tagline}</p>
  </div>
  <nav class="site-nav" aria-label="Main">
    {
      links.map((link) => (
        <a href={link.href} aria-current={current === link.key ? "page" : undefined}>
          {link.label}
        </a>
      ))
    }
  </nav>
</header>
