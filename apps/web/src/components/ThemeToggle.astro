---
/**
 * ThemeToggle — cycles light -> sepia -> dark and persists to localStorage.
 * The label reflects the *next* theme so the action is self-describing.
 *
 * The icon shows the current theme (sun / open book / moon). All three are in
 * the markup; CSS shows the one matching <html data-theme>, so the right icon
 * is there from first paint and the script only has to keep the label current.
 */
---

<button class="btn btn-icon" id="theme-toggle" type="button" aria-label="Change theme" title="Change reading theme">
  <svg class="theme-icon" data-theme-icon="light" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" />
  </svg>
  <svg class="theme-icon" data-theme-icon="sepia" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d="M12 6.5C10.3 5.2 7.8 4.5 3.5 4.5v13.5c4.3 0 6.8.7 8.5 2 1.7-1.3 4.2-2 8.5-2V4.5c-4.3 0-6.8.7-8.5 2Z" />
    <path d="M12 6.5V20" />
  </svg>
  <svg class="theme-icon" data-theme-icon="dark" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d="M20.5 14.5A8.5 8.5 0 1 1 9.5 3.5a6.8 6.8 0 0 0 11 11Z" />
  </svg>
</button>

<script>
  // Bundled module script (not is:inline) so the strict CSP covers it.
  const order = ["light", "sepia", "dark"] as const;
  type Theme = (typeof order)[number];
  const labels: Record<Theme, string> = { light: "Light", sepia: "Sepia", dark: "Dark" };

  const btn = document.getElementById("theme-toggle");

  function current(): Theme {
    const t = document.documentElement.getAttribute("data-theme");
    return order.includes(t as Theme) ? (t as Theme) : "light";
  }

  function paint(): void {
    const now = current();
    const next = order[(order.indexOf(now) + 1) % order.length] ?? "light";
    btn?.setAttribute("aria-label", `Theme: ${labels[now]}. Switch to ${labels[next]}`);
    btn?.setAttribute("title", `Theme: ${labels[now]} (click for ${labels[next]})`);
  }

  btn?.addEventListener("click", () => {
    const next = order[(order.indexOf(current()) + 1) % order.length] ?? "light";
    document.documentElement.setAttribute("data-theme", next);
    try {
      localStorage.setItem("readbook-theme", next);
    } catch {
      // Private mode / storage disabled: the choice just won't persist.
    }
    paint();
  });
  paint();
</script>
