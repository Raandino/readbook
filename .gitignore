# Dependencies / build output
node_modules/
dist/
.builds/
.astro/
.turbo/
*.tsbuildinfo
coverage/

# Local SQLite databases (your shelf + settings, incl. any saved API key).
# Matched at any depth so a stray apps/web/data/ can never be committed.
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
/data/
apps/web/data/

# Env — real values never get committed; only the template does.
.env
.env.*
!.env.example
.dev.vars

# Local tool / agent artifacts
.playwright-mcp/
.claude/settings.local.json
.claude/worktrees/

# Local dev screenshots at the repo root (README images live in docs/)
/*.png

# OS / editor
.DS_Store
*.log
.vscode/
.idea/
