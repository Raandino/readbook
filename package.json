{
  "name": "readbook",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "bootstrap": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "pnpm run build && pnpm --filter @readbook/web run start",
    "preview": "pnpm run build && pnpm --filter @readbook/web run preview",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && node scripts/check-format.mjs",
    "format:check": "node scripts/check-format.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run typecheck && pnpm run format:check && pnpm run test && pnpm run build",
    "db:studio": "pnpm --filter @readbook/db run db:studio"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "turbo": "2.10.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "ignoredOptionalDependencies": [
      "sharp"
    ],
    "overrides": {
      "follow-redirects": ">=1.16.2",
      "source-map-js": ">=1.2.2"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mrhx-c7xc-m3w5"
      ]
    }
  },
  "description": "A calm, local-first read-it-later: paste any link, read it like a book.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Raandino/readbook.git"
  },
  "homepage": "https://github.com/Raandino/readbook#readme",
  "bugs": {
    "url": "https://github.com/Raandino/readbook/issues"
  }
}
